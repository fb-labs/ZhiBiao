# ============================================================================
# 智标 - 环境配置（所有变量统一使用 ZHIBIAO_ 前缀）
# 复制为 .env 后按需修改；只有 AI_API_KEY 是模型功能的必填项。
# ============================================================================

ZHIBIAO_APP_NAME=智标
ZHIBIAO_APP_VERSION=2.0
ZHIBIAO_DEBUG=false

# 页面与 API 共用这一个端口
ZHIBIAO_HOST=127.0.0.1
ZHIBIAO_PORT=8000
# 前端构建产物目录（cd packages/web && npm run build 输出到这里）
ZHIBIAO_WEB_DIST=./web_dist

# ── 数据库：postgresql（默认）/ mysql / sqlite ─────────────────
ZHIBIAO_DB_TYPE=postgresql
ZHIBIAO_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zhibiao

# MySQL 方式填写以下组合（并把 ZHIBIAO_DB_TYPE 改为 mysql）
ZHIBIAO_MYSQL_HOST=localhost
ZHIBIAO_MYSQL_PORT=3306
ZHIBIAO_MYSQL_USER=root
ZHIBIAO_MYSQL_PASSWORD=root
ZHIBIAO_MYSQL_DATABASE=zhibiao

# ── 运行数据目录 ───────────────────────────────────────────────
ZHIBIAO_DATA_ROOT=./var
ZHIBIAO_UPLOAD_ROOT=./var/uploads
ZHIBIAO_DELIVERY_ROOT=./var/deliveries
ZHIBIAO_TEMPLATE_ROOT=./var/templates

# ── 模型服务（OpenAI 兼容接口）─────────────────────────────────
ZHIBIAO_AI_BASE_URL=https://token.sensenova.cn/v1
ZHIBIAO_AI_API_KEY=
ZHIBIAO_AI_MODEL=sensenova-6.8-flash
ZHIBIAO_AI_TIMEOUT=60

# ── 初始管理员（首次启动自动创建，已存在则跳过）──────────────
ZHIBIAO_BOOTSTRAP_USERNAME=admin
ZHIBIAO_BOOTSTRAP_PASSWORD=sxit@123456

# 额外允许的跨域来源（逗号分隔，可选；页面与 API 同源时留空）
ZHIBIAO_ALLOWED_ORIGINS=
