# ============================================================================
# 智标 - Docker 编排变量
# 复制为 docker/.env.docker 后修改。
#
# 全量部署（含 PostgreSQL）：
#   docker compose -f docker/docker-compose.yml --env-file docker/.env.docker --profile infra up -d --build
# 仅 API（外部数据库）：
#   docker compose -f docker/docker-compose.yml --env-file docker/.env.docker up -d
# ============================================================================

API_PORT=8000
# 必须为 1：登录会话保存在进程内，多 worker 会导致随机掉登录
UVICORN_WORKERS=1
ZHIBIAO_DEBUG=false

# ── 数据库（compose 内置 PostgreSQL）──────────────────────────
POSTGRES_DB=zhibiao
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# 外部数据库时覆盖：
# ZHIBIAO_DATABASE_URL=postgresql+asyncpg://user:pass@192.168.1.100:5432/zhibiao

# ── 模型服务（必填 Key）───────────────────────────────────────
ZHIBIAO_AI_BASE_URL=https://token.sensenova.cn/v1
ZHIBIAO_AI_API_KEY=
ZHIBIAO_AI_MODEL=sensenova-6.8-flash
ZHIBIAO_AI_TIMEOUT=60

# ── 初始管理员 ────────────────────────────────────────────────
ZHIBIAO_BOOTSTRAP_USERNAME=admin
ZHIBIAO_BOOTSTRAP_PASSWORD=sxit@123456

# 额外允许的跨域来源（可选）
ZHIBIAO_ALLOWED_ORIGINS=
